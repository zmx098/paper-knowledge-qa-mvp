# ============ LLM 配置（OpenAI 兼容接口）============
# 本项目通过 OpenAI 兼容接口接入各家大模型，以下给出三种常见配置，复制所需段落即可。

# ---------- 方案 A：OpenAI ----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------- 方案 B：豆包 / 火山方舟（OpenAI 兼容）----------
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=你的火山方舟 API Key
# LLM_CHAT_MODEL=你的推理接入点 ID（如 ep-xxxx）或模型名（如 doubao-seed-1-6-250615）
# LLM_EMBED_MODEL=你的嵌入接入点 ID 或模型名（如 doubao-embedding-large-250715）
# EMBEDDING_DIM=1024

# ---------- 方案 C：DeepSeek（注意：DeepSeek 没有 embedding 接口）----------
# 使用 DeepSeek 时请将 RETRIEVAL_MODE 设为 bm25（本地关键词检索，无需嵌入向量）：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_CHAT_MODEL=deepseek-chat
# RETRIEVAL_MODE=bm25

# ============ 检索与分块 ============
# 检索模式：vector（向量检索）/ bm25（本地关键词检索）/ hybrid（两者融合，默认）
RETRIEVAL_MODE=hybrid
# 每次回答检索返回的片段数
TOP_K=5
# 文本分块大小（字符数）与重叠
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ============ 数据目录 ============
# 论文存放目录（默认 data/papers，可自行修改）
# PAPERS_DIR=data/papers
# 索引与向量库持久化目录（默认 data/db）
# DB_DIR=data/db
